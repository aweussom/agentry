# agentry configuration template.
# Copy this file to `agentry.ini` (gitignored) and fill in the values.
# `agentry.ini` holds a secret (a GitHub PAT) and is never committed.

[copilot_quota]
# Optional. Show remaining GitHub Copilot *premium-request* quota in the
# console when running the `copilot` backend. Leave `pat` blank to disable
# (the default — no quota shown for copilot).
#
# NOTE: gpt-5-mini does not consume premium requests, so this is a GLOBAL
# monthly figure across ALL your Copilot usage (CLI, IDE, agentry), not
# agentry's own consumption. It reads the documented GitHub billing API:
#   GET /users/{username}/settings/billing/premium_request/usage
#
# IMPORTANT: only works for accounts that pay their OWN Copilot bill. If your
# Copilot license is managed/billed by an organization or enterprise (e.g. an
# SSO / enterprise-managed user), per-user billing is not exposed (HTTP 400/403)
# and agentry disables the display automatically. Verified working on a
# personally-billed account.
#
# Fine-grained PAT with Account permissions -> "Plan" : Read-only.
# Create at: https://github.com/settings/personal-access-tokens/new
pat =

# Optional: PAT expiry (ISO 8601) + a label, so the console warns when the
# token is within 14 days of expiring. Leave `expiry` blank for a no-expiry PAT.
expiry =
pat_name =

# Your GitHub username (the {username} in the billing API path).
username =

# Plan tier, used to derive the monthly premium-request limit:
#   free = 50    pro = 300    pro_plus = 1500
plan = pro

# Optional: override the monthly premium-request limit directly (integer).
# Takes precedence over `plan` — use if your org/plan has a custom allotment.
monthly_limit =
